# --- Web server ---
# Address and port the Axum backend binds to (localhost-only by design).
BIND_ADDR=127.0.0.1:8787

# --- Whisper (speech-to-text) ---
# Path to a ggml Whisper model file (.bin). Download (English-optimized small):
#   curl -L -o models/ggml-small.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.en.bin
# The .en variants are tuned for English-only, which is what this app forces.
# Model size is configurable so you can trial base/medium/large later without
# code changes (medium/large are slow on CPU).
WHISPER_MODEL=models/ggml-small.en.bin
# Enable whisper.cpp GPU (CUDA) inference. Requires building with `--features cuda`
# and a CUDA-capable GPU. If you hit issues, leave this 0 (CPU works fine).
WHISPER_USE_GPU=0
# Seed vocabulary bias for the decoder. Helps technical terms survive as ASR
# artifacts (e.g. "NestJS" heard as "NAS.js"). Defaults to a small tech-term list;
# only set this to override it entirely.
# WHISPER_INITIAL_PROMPT=Node.js, NestJS, TypeScript, JavaScript, AWS

# --- Local LLM (analysis + CEFR) ---
# Ollama serves an OpenAI-compatible API at localhost:11434.
OLLAMA_URL=http://localhost:11434
# Model served by Ollama for grammar/vocab analysis. Pull one first, e.g.:
#   ollama pull llama3.1:8b
#   ollama pull qwen2.5:3b
# llama3.1:8b was picked by benchmarks (fewest false positives, best CEFR
# justification); it also outperformed qwen2.5:7b and llama3.2 on this task.
LLM_MODEL=llama3.1:8b
# Low temperature keeps structured extraction stable.
LLM_TEMPERATURE=0.1
